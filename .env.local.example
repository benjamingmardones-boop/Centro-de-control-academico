NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Esta es distinta de la anon key: es la "service_role key", secreta.
# Se usa SOLO en el servidor (nunca llega al navegador) para poder generar
# tu enlace de calendario de Outlook sin pedirte iniciar sesión cada vez.
# La encuentras en el mismo lugar: Project Settings -> API -> Project API keys.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
